{
  "comments": {
    "lineComment": ";"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["\"", "\""]
  ],
  "wordPattern": "[a-zA-Z!?*/<>=][a-zA-Z0-9!?*\\-+/<>=:]*",
  "indentationRules": {
    "increaseIndentPattern": "\\([^)]*$",
    "decreaseIndentPattern": "^\\s*\\)"
  }
}
