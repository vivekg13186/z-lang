{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Z",
  "scopeName": "source.z",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#fn-definition" },
    { "include": "#lambda-definition" },
    { "include": "#special-forms" },
    { "include": "#builtins-system" },
    { "include": "#builtins-collection" },
    { "include": "#builtins-string" },
    { "include": "#builtins-math" },
    { "include": "#builtins-io" },
    { "include": "#builtins-namespaced" },
    { "include": "#operators" },
    { "include": "#constants" },
    { "include": "#number" },
    { "include": "#symbol" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.semicolon.z",
      "match": ";.*$"
    },
    "string": {
      "name": "string.quoted.double.z",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.z",
          "match": "\\\\(n|t|r|\"|\\\\|0|\\$)"
        },
        {
          "name": "meta.template.expression.z",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.z" } },
          "endCaptures":   { "0": { "name": "punctuation.section.embedded.end.z" } },
          "patterns": [ { "include": "$self" } ]
        }
      ]
    },
    "number": {
      "name": "constant.numeric.z",
      "match": "(?<![\\w.])-?\\d+(\\.\\d+)?([eE][+-]?\\d+)?(?![\\w.])"
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.z",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.z",
          "match": "\\bnull\\b"
        }
      ]
    },
    "special-forms": {
      "name": "keyword.control.z",
      "match": "(?<=\\()\\s*(do|if|while|for|fn|lambda|set|try|catch|quote|and|or|import|return|break|continue|match)\\b"
    },
    "fn-definition": {
      "begin": "(\\()\\s*(fn)\\s+([A-Za-z_][\\w\\-?!:.]*)",
      "beginCaptures": {
        "1": { "name": "punctuation.section.parens.begin.z" },
        "2": { "name": "keyword.control.z" },
        "3": { "name": "entity.name.function.z" }
      },
      "end": "(?=\\))",
      "patterns": [
        {
          "begin": "(\\()",
          "beginCaptures": {
            "1": { "name": "punctuation.section.parens.begin.z" }
          },
          "end": "(\\))",
          "endCaptures": {
            "1": { "name": "punctuation.section.parens.end.z" }
          },
          "patterns": [
            {
              "name": "variable.parameter.z",
              "match": "[A-Za-z_][\\w\\-?!:.]*"
            }
          ]
        },
        { "include": "$self" }
      ]
    },
    "lambda-definition": {
      "begin": "(\\()\\s*(lambda)\\b",
      "beginCaptures": {
        "1": { "name": "punctuation.section.parens.begin.z" },
        "2": { "name": "keyword.control.z" }
      },
      "end": "(?=\\))",
      "patterns": [
        {
          "begin": "(\\()",
          "beginCaptures": {
            "1": { "name": "punctuation.section.parens.begin.z" }
          },
          "end": "(\\))",
          "endCaptures": {
            "1": { "name": "punctuation.section.parens.end.z" }
          },
          "patterns": [
            {
              "name": "variable.parameter.z",
              "match": "[A-Za-z_][\\w\\-?!:.]*"
            }
          ]
        },
        { "include": "$self" }
      ]
    },
    "builtins-system": {
      "name": "support.function.system.z",
      "match": "(?<=\\(|\\s)(print|type|assert|sleep|now|timestamp|format-date|env|exec|run|argv|exit|import)\\b"
    },
    "builtins-collection": {
      "name": "support.function.collection.z",
      "match": "(?<=\\(|\\s)(array|object|get|put|push|pop|length|keys|values|entries|map|filter|reduce)\\b"
    },
    "builtins-string": {
      "name": "support.function.string.z",
      "match": "(?<=\\(|\\s)(concat|split|trim|lower|upper|replace|substring|starts-with|ends-with|contains|index-of)\\b"
    },
    "builtins-math": {
      "name": "support.function.math.z",
      "match": "(?<=\\(|\\s)(min|max|floor|ceil|abs|random)\\b"
    },
    "builtins-io": {
      "name": "support.function.io.z",
      "match": "(?<=\\(|\\s)(read|write|append|delete)\\b"
    },
    "builtins-namespaced": {
      "name": "support.function.namespaced.z",
      "match": "(?<=\\(|\\s)(json:parse|json:stringify|http:get|http:post|regex:test|regex:match|regex:find-all|regex:replace|regex:split|img:create|img:resize|img:crop|img:rotate|img:circle|img:rect|img:add-text|img:bw|img:grayscale|img:to-pdf|img:info)\\b"
    },
    "operators": {
      "name": "keyword.operator.z",
      "match": "(?<=\\(|\\s)(\\+|\\-|\\*|/|%|<=|>=|==|!=|<|>|&&|\\|\\||!)(?=\\s|\\))"
    },
    "symbol": {
      "name": "variable.other.z",
      "match": "[A-Za-z_][\\w\\-?!:.]*"
    }
  }
}
