; Recursive Fibonacci — tests function definition and recursion.

(fn fib (n)
    (if (< n 2)
        n
        (+ (fib (- n 1)) (fib (- n 2)))
    )
)

(print "fib(10) =" (fib 10))
(print "fib(15) =" (fib 15))
(print "fib(20) =" (fib 20))

; Iterative version using while.
(fn fib-iter (n)
    (do
        (set a 0)
        (set b 1)
        (set i 0)
        (while (< i n)
            (do
                (set tmp (+ a b))
                (set a b)
                (set b tmp)
                (set i (+ i 1))
            )
        )
        a
    )
)

(print "fib-iter(20) =" (fib-iter 20))
(print "fib-iter(30) =" (fib-iter 30))
